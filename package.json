{
  "name": "monospire",
  "productName": "Monospire",
  "version": "2.3.0",
  "description": "A focused Markdown editor",
  "main": "main.js",
  "scripts": {
    "build:codemirror": "node ./scripts/build-codemirror.mjs",
    "prestart": "npm run build:codemirror",
    "start": "electron .",
    "test": "node tests/mindmap-core.test.js && node tests/mmap-importer.test.js && node tests/renderer-pane-layout.test.js && node tests/renderer-mindmap-view.test.js",
    "prepack:app": "npm run build:codemirror",
    "prepack:mac": "npm run build:codemirror",
    "pack:app": "bash ./scripts/package-app.sh",
    "predist:mac": "npm run build:codemirror",
    "pack:mac": "electron-builder --mac --dir",
    "dist:mac": "electron-builder --mac && npm run brew:cask",
    "dist:linux": "electron-builder --linux AppImage deb rpm tar.xz --x64 --arm64 --publish never",
    "brew:cask": "bash ./scripts/generate-homebrew-cask.sh",
    "release:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run dist:mac && bash ./scripts/upload-macos-artifacts-to-github-release.sh"
  },
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "macos",
    "monospire"
  ],
  "author": {
    "name": "CurzonMonroe",
    "email": "darren@houseofwray.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.7.0",
    "esbuild": "^0.28.0"
  },
  "build": {
    "appId": "com.monospire.app",
    "productName": "Monospire",
    "buildVersion": "2.3.0.0",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "mermaid-worker.html",
      "mermaid-worker.js",
      "mindmap-core.js",
      "mmap-importer.js",
      "renderer-pane-layout.js",
      "renderer-mindmap-view.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "themes/**/*",
      "vendor/**/*",
      "scripts/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/Monospire.icns",
      "target": [
        "dir",
        "dmg"
      ]
    },
    "linux": {
      "category": "Utility",
      "executableName": "monospire",
      "mimeTypes": [
        "text/markdown",
        "text/x-markdown"
      ],
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.xz"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "Monospire"
        }
      },
      "maintainer": "CurzonMonroe <darren@houseofwray.com>"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "role": "Editor",
        "icon": "assets/Monospire.icns"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "role": "Editor",
        "icon": "assets/Monospire.icns"
      },
      {
        "ext": "mmap",
        "name": "MindManager Map",
        "role": "Viewer",
        "icon": "assets/Monospire.icns"
      }
    ]
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "highlight.js": "^11.11.1",
    "html-to-docx": "^1.8.0",
    "katex": "^0.17.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^10.9.5",
    "morphdom": "^2.7.5",
    "turndown": "^7.2.0"
  },
  "homepage": "https://github.com/CurzonMonroe/Monospire"
}
